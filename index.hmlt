  .btns { display:flex; flex-wrap:wrap; gap:10px; }
  .btn { display:inline-block; padding:10px 18px; border-radius:8px; border:1px solid var(--accent); color:var(--accent); text-decoration:none; font-weight:600; font-size:15px; }
  .btn.primary { background:var(--accent); color:var(--bg); }
