  @media (prefers-color-scheme: dark) {
    :root { --bg:#161615; --fg:#ecebe5; --muted:#a3a198; --line:#34332f; --card:#1f1f1d; --accent:#b4adf5; --accent2:#ff8a80; --soft:#26234a; --ok:#10332a; --okline:#5dcaa5; --warn:#3a2a10; --warnline:#e0a04a; --code:#262623; }
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--fg); font:17px/1.65 Georgia, "Times New Roman", serif; }
  .wrap { max-width:860px; margin:0 auto; padding:0 20px; }
  h1,h2,h3,nav,.sans,table,.btn,code,pre,.tag { font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
