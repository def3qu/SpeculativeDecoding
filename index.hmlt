<line x1="56" x2="570" y1="142.4" y2="142.4" class="grid"/><text x="48" y="146.4" text-anchor="end" class="tick">1.8x</text>
<line x1="56" x2="570" y1="79.2" y2="79.2" class="grid"/><text x="48" y="83.2" text-anchor="end" class="tick">2.0x</text>
<line x1="56" x2="570" y1="16.0" y2="16.0" class="grid"/><text x="48" y="20.0" text-anchor="end" class="tick">2.2x</text>
<text x="56.0" y="352" text-anchor="middle" class="tick">1</text>
<text x="184.5" y="352" text-anchor="middle" class="tick">2</text>
