"""
speculativeTestSpec.py

Runs a speculative decoding experiment over many prompts and draft lengths,
and writes one CSV row per run.

For every prompt, each repetition runs:
  1. A baseline: the target model alone, greedy decoding.
  2. Speculative decoding for each K in K_VALUES.

Baseline and speculative runs use the same style of loop (no KV cache), so
the speedup compares the algorithms rather than two different implementations.

Choose the prompts with PROMPT_SET below:
  "builtin"    the 20 prompts below (4 categories of 5)
  "specbench"  the 480 Spec-Bench prompts (spec_bench_questions.jsonl), the
               standard benchmark for speculative decoding

prompt_id and task match alphaTest.py, so results can be joined with the
alpha CSV on prompt_id (or grouped by task) to compare predicted and measured
speedups.

Outputs:
  results_<pair>_<set>_<timestamp>.csv    one row per run (metrics)
  outputs_<pair>_<set>_<timestamp>.jsonl  generated text from the first repetition

Before the first run, log in once with `hf auth login` so the gated Llama
models can download. After that, `export HF_HUB_OFFLINE=1` runs fully offline.
The Qwen models are not gated.
"""

import csv
import json
import os
import time
from collections import defaultdict
from datetime import datetime

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer

   RESUME_FROM = "results_llama_specbench_20261021-105500.csv"   # your actual filename
# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

# Draft and target must share a tokenizer, since token ids are compared directly.
# All Qwen2.5 models share one tokenizer; all Llama 3.x models share another.
MODEL_PAIRS = {
    "qwen": ("Qwen/Qwen2.5-0.5B-Instruct", "Qwen/Qwen2.5-7B-Instruct"),
    "llama": ("meta-llama/Llama-3.2-1B-Instruct", "meta-llama/Llama-3.1-8B-Instruct"),
}

MODEL_PAIR = "llama"

# Which prompts to use: "builtin" or "specbench".
PROMPT_SET = "specbench"

# Path to the Spec-Bench question file (used only when PROMPT_SET = "specbench").
SPEC_BENCH_FILE = "spec_bench_questions.jsonl"

# Use only the first N prompts of each task, for quick tests. None uses all.
# Spec-Bench has 6 tasks, so 5 here gives a 30-prompt trial run.
MAX_PROMPTS_PER_TASK = None

MAX_NEW_TOKENS = 100

# Draft lengths to test.
K_VALUES = [1, 2, 3, 5, 8]

# Repetitions per configuration. Greedy decoding produces the same tokens
# each time, so repeats measure timing noise only. With 480 Spec-Bench
# prompts, 1 is usually enough: timing noise averages out across prompts,
# and each extra repetition adds the full run time again.
RUNS_PER_CONFIG = 1

# To continue a run that stopped early, set this to its results CSV, e.g.
# "results_llama_specbench_20261021-105500.csv". Prompts that finished are
# skipped, rows from a prompt that was cut off partway are discarded and that
# prompt is rerun, and new rows are added to the same CSV and outputs files.
# Leave as None to start a fresh run.
RESUME_FROM = None


PROMPTS = {
    "code": [
        "Write a Python function that checks whether a string is a palindrome.",
        "Write a Python function that returns the nth Fibonacci number using iteration.",
        "Write a SQL query that finds the five highest-paid employees in an employees table.",
        "Write a JavaScript function that removes duplicate values from an array.",
        "Write a Python class for a stack with push, pop, and peek methods.",
    ],
    "factual": [
